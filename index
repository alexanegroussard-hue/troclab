<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Troclab – Concept PFE</title>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <style>
    /* --- CSS GLOBAL & NAVIGATION SPA --- */
    .spa-section { display: none; }
    .spa-section.active { display: block; }
    
    nav .nav-links a { cursor: pointer; padding: 5px 10px; border-radius: 5px; }
    nav .nav-links a.active-link { color: #0099ff !important; font-weight: 700; background: #e8f4ff; }

    /* --- FUSION DES STYLES (CARTE + MESSAGERIE + PROFIL) --- */
    /* On garde toutes tes variables racine */
    :root {
      --blue: #0099ff; --blue-dark: #0077cc; --blue-light: #e8f4ff;
      --orange: #d6965e; --orange-light: #fff3e8; --green: #2ea04d;
      --bg: #f0f4fa; --white: #ffffff; --text: #1a1a2e;
      --muted: #7a8a9a; --border: #dde3ef; --shadow: 0 4px 24px rgba(0,100,200,0.08);
    }
    /* Styles communs */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Figtree', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    
    /* Styles spécifiques CARTE */
    .app { display: grid; grid-template-columns: 340px 1fr; height: 100vh; padding-top: 60px; }
    .sidebar { background: var(--white); border-right: 1px solid var(--border); display: flex; flex-direction: column; overflow: hidden; }
    /* ... (tous tes styles de index.html originaux ici) */
    
    /* Styles spécifiques MESSAGERIE */
    .layout-msg { display: grid; grid-template-columns: 300px 1fr 320px; height: 100vh; padding-top: 58px; }
    /* ... (tous tes styles de troclab-messagerie.html ici) */

    /* Styles spécifiques PROFIL */
    .profile-main { padding-top: 78px; max-width: 980px; margin: 0 auto; padding-bottom: 60px; }
    /* ... (tous tes styles de troclab-profil.html ici) */
    
    /* J'ai inclus ici une version compactée de tes CSS pour que le fichier fonctionne */
    nav { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; background: rgba(255,255,255,0.94); backdrop-filter: blur(14px); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 28px; height: 58px; }
    .nav-logo { font-size: 1.3rem; font-weight: 900; letter-spacing: -0.5px; } .nav-logo span { color: var(--blue); }
    .nav-links { display: flex; gap: 24px; align-items: center; } .nav-links a { text-decoration: none; color: var(--muted); font-size: 0.88rem; font-weight: 500; transition: 0.2s; }
  </style>
</head>
<body>

<nav>
  <div class="nav-logo">Troc<span>lab</span></div>
  <div class="nav-links">
    <a id="btn-carte" onclick="openTab('carte')" class="active-link">Carte</a>
    <a id="btn-messagerie" onclick="openTab('messagerie')">Messagerie</a>
    <a id="btn-profil" onclick="openTab('profil')">Mon profil</a>
  </div>
  <div class="nav-avatar" style="width:34px; height:34px; background:var(--blue); color:white; border-radius:10px; display:flex; align-items:center; justify-content:center; font-weight:700; cursor:pointer">ML</div>
</nav>

<div id="sec-carte" class="spa-section active">
   <div class="app">
      <aside class="sidebar">
        <div class="sidebar-header"><h2>Trouver un partenaire</h2><div class="search-bar"><input type="text" id="searchInput" placeholder="Rechercher..." oninput="filterCards()"></div></div>
        <div class="filters">
            <div class="filter-label">Profil</div>
            <div class="filter-tags"><button class="tag active" onclick="toggleFilter(this,'profile','all')">Tous</button><button class="tag" onclick="toggleFilter(this,'profile','maker')">🛠 Maker</button></div>
        </div>
        <div class="results"><div id="cardList"></div></div>
      </aside>
      <main class="map-area" id="mapArea">
        <div class="map-svg-wrap"><svg class="france-map" viewBox="0 0 700 620"><g id="pinsLayer"></g></svg></div>
        <div class="map-popup" id="mapPopup" style="display:none"></div>
      </main>
   </div>
</div>

<div id="sec-messagerie" class="spa-section">
  <div class="layout-msg" style="display:grid; grid-template-columns: 300px 1fr 320px; height: calc(100vh - 58px); margin-top:58px;">
    <aside class="conv-panel"><div id="convList"></div></aside>
    <section class="chat-panel">
        <div id="chatContent" style="display:none; flex-direction:column; height:100%;">
            <div class="chat-header" id="chatHeader"></div>
            <div class="messages" id="messagesList"></div>
            <div class="chat-input-area"><input type="text" id="msgInput" onkeydown="handleKey(event)"><button onclick="sendMessage()">➤</button></div>
        </div>
    </section>
    <aside class="info-panel" id="infoPanel"></aside>
  </div>
</div>

<div id="sec-profil" class="spa-section">
  <div class="profile-main" style="padding-top:80px; max-width:900px; margin:0 auto;">
    <div class="profile-wrap" style="display:grid; grid-template-columns: 300px 1fr; gap:20px;">
        <div class="profile-sidebar"><div class="profile-hero"><div class="profile-info"><h3>MixLab Lyon</h3></div></div></div>
        <div class="profile-content"><div class="section-card"><h3>Historique des trocs</h3><div class="section-card-body" id="trocHistory"></div></div></div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  // --- LOGIQUE DE NAVIGATION SPA ---
  function openTab(tabName) {
    document.querySelectorAll('.spa-section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active-link'));
    
    document.getElementById('sec-' + tabName).classList.add('active');
    document.getElementById('btn-' + tabName).classList.add('active-link');
    
    // Relancer les rendus spécifiques si besoin
    if(tabName === 'carte') render();
    if(tabName === 'messagerie') renderConvs();
  }

  // --- SCRIPTS DE LA CARTE (Inchangés) ---
  const orgs = [ {id:1, name:"FabLab Nantes", city:"Nantes", type:"maker", emoji:"🏭", x:220, y:270, color:"#0099ff", offers:["Impression 3D"], needs:["Gouvernance"], match:92, domains:["fabrication"]} ];
  function render() { /* ton code original */ }
  // ... (colle ici tout le bloc <script> de ton fichier index.html)

  // --- SCRIPTS DE LA MESSAGERIE (Inchangés) ---
  const conversations = [ {id:1, name:"FabLab Nantes", emoji:"🏭", status:"active", messages:[]} ];
  function renderConvs() { /* ton code original */ }
  // ... (colle ici tout le bloc <script> de ton fichier messagerie.html)

  // --- SCRIPTS DU PROFIL (Inchangés) ---
  function showView(v) { /* ton code original */ }
</script>
</body>
</html>
